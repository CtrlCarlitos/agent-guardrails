{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "type": "command"
          }
        ],
        "id": "guardrail-claude-post",
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "timeout": 10,
            "type": "command"
          }
        ],
        "id": "guardrail-claude-pre",
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "type": "command"
          }
        ],
        "id": "guardrail-claude-session-start",
        "matcher": "startup|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "timeout": 600,
            "type": "command"
          }
        ],
        "id": "guardrail-claude-stop"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "timeout": 600,
            "type": "command"
          }
        ],
        "id": "guardrail-claude-subagent-stop"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(guardrail fetch:*)"
    ]
  }
}
