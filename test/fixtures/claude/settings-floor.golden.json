{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "type": "command"
          }
        ],
        "id": "guardrail-claude-post",
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "timeout": 10,
            "type": "command"
          }
        ],
        "id": "guardrail-claude-pre",
        "matcher": "Bash|Read|Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "type": "command"
          }
        ],
        "id": "guardrail-claude-session-start",
        "matcher": "startup|clear|compact"
      }
    ]
  },
  "permissions": {
