{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "type": "command"
          }
        ],
        "id": "guardrail-claude-post",
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "timeout": 10,
            "type": "command"
          }
        ],
        "id": "guardrail-claude-pre",
        "matcher": "Bash|Read|Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/guardrail hook claude",
            "type": "command"
          }
        ],
        "id": "guardrail-claude-session-start",
        "matcher": "startup|clear|compact"
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(chmod -R *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)",
      "Bash(truncate *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(find * -delete)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git branch -D *)",
      "Bash(git commit --amend*)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git stash clear)",
      "Bash(git stash drop*)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push --tags*)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(yarn add *)",
      "Bash(pnpm add *)",
      "Bash(gem install *)",
      "Bash(cargo install *)",
      "Bash(go install *)",
      "Bash(go get *)",
      "Edit(.github/workflows/**)",
      "Edit(.gitlab-ci.yml)",
      "Edit(.circleci/**)",
      "Edit(Jenkinsfile)",
      "Edit(.buildkite/**)",
      "Edit(.pre-commit-config.yaml)",
      "Edit(azure-pipelines.yml)",
      "Edit(Dockerfile)",
      "Edit(docker-compose*.yml)",
      "Edit(*.tf)",
      "Edit(Makefile)",
      "Edit(justfile)",
      "Edit(Taskfile.yml)",
      "Edit(setup.py)",
      "Edit(conftest.py)",
      "Edit(noxfile.py)",
      "Edit(package-lock.json)",
      "Edit(yarn.lock)",
      "Edit(pnpm-lock.yaml)",
      "Edit(Cargo.lock)",
      "Edit(poetry.lock)",
      "Edit(uv.lock)",
      "Edit(go.sum)",
      "Edit(Gemfile.lock)",
      "Edit(mix.lock)",
      "Edit(composer.lock)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(wipefs *)",
      "Bash(shred *)",
      "Bash(srm *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(su)",
      "Bash(doas *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git clean -f*)",
      "Bash(git clean -xf*)",
      "Bash(git clean -fx*)",
      "Bash(git clean -df*)",
      "Bash(git clean -fd*)",
      "Bash(git reset --hard*)",
      "Bash(git reset --keep*)",
      "Bash(git config *)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(pip install --index-url*)",
      "Bash(pip3 install --index-url*)",
      "Bash(npm install --registry*)",
      "Bash(docker compose down*)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker network prune*)",
      "Read(**/.env)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.kube/config)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.docker/config.json)",
      "Read(**/.git-credentials)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(service-account*.json)",
      "Read(**/.claude.json)",
      "Read(/root/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.ssh/**)",
      "Edit(**/.aws/**)",
      "Edit(**/.config/gcloud/**)",
      "Edit(**/.kube/config)",
      "Edit(**/.netrc)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)",
      "Edit(**/.docker/config.json)",
      "Edit(**/.git-credentials)",
      "Edit(id_rsa*)",
      "Edit(id_ed25519*)",
      "Edit(*.pem)",
      "Edit(*.key)",
      "Edit(service-account*.json)",
      "Edit(**/.claude.json)",
      "Edit(/root/.ssh/**)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(AGENTS.md)",
      "Edit(.mcp.json)",
      "Edit(.envrc)",
      "Edit(**/.bashrc)",
      "Edit(**/.zshrc)",
      "Edit(**/.profile)",
      "Edit(**/.bash_profile)",
      "Edit(**/.git/config)",
      "Edit(**/.git/hooks/**)"
    ]
  }
}
