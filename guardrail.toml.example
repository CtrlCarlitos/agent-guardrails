# A project's Overlay. Commit it (or gitignore it) at the repo root.
# Merged on top of the shipped Base policy: it may add and tighten freely. Any
# request that would loosen the Guardrail Policy needs an Operator config grant.

engine_min_version = "0.1"

# Optional: request a different audit-log stream for this repo. This takes
# effect only when the Operator config grants `audit_log = true` to this repo.
# audit_log = ".agents/guardrail.jsonl"

[slots]
# Fill the Base policy's parameterized holes.
# `secret_allow` entries require an Operator config grant. `safe_roots` has no
# such grant: every entry must resolve inside this repository or it is dropped.
# Every `egress_allowlist` entry needs an exact per-repository Operator config
# grant. Total wildcards `*` and `**` are always dropped, even when granted.
safe_roots        = ["./tmp", "./.cache"]              # P1: rm -rf permitted here
egress_allowlist  = ["api.github.com"]                 # P6: hosts curl/wget may reach
ephemeral_db_glob = "*_scratch"                        # P11 (overlay): DBs safe to mutate
container_scheme  = "{project}-{worktree}-{service}"   # P1 docker guard: real container names

[recipes]
# Which language recipes are active here, and any per-tier command overrides.
enabled = ["go", "python"]

# Extra project rules (added to the Base).
[[rules]]
match   = "terraform apply*"
verdict = "ask"
reason  = "infra change — human in the loop"

# Switch a Base rule off for this project. This is a REQUEST, not a grant:
# it takes effect only if the operator has authorized this repo for this rule
# in the Operator config (see docs/operator-config.md and ADR-0010).
# An unauthorized request is dropped, the rule stays enforced, and the refusal
# is reported by `guardrail doctor` and in Claude's SessionStart posture.
# waive = ["P7.trifecta"]
