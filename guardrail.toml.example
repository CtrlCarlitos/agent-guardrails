# A project's Overlay. Commit it (or gitignore it) at the repo root.
# Merged on top of the shipped Base policy: it may add and tighten freely. Any
# request that would loosen the Guardrail Policy needs an Operator config grant.

engine_min_version = "0.1"

# Optional: request a different audit-log stream for this repo. This takes
# effect only when the exact cleaned absolute repository path in the Operator
# config grants `audit_log = true`.
# audit_log = ".agents/guardrail.jsonl"

# Switch a Base rule off for this project. This is a Waiver request, not a
# grant: it takes effect only when the exact cleaned absolute repository path
# in the Operator config lists this exact rule ID in `waive`. An unauthorized
# request is dropped, the rule stays enforced, and the refusal is reported by
# `guardrail doctor` and in Claude's SessionStart posture.
# waive = ["P7.trifecta"]

[slots]
# Fill the Base policy's parameterized holes.
# `secret_allow` entries require an Operator config grant. `safe_roots` has no
# such grant: every entry must resolve inside this repository or it is dropped.
# Every `egress_allowlist` entry needs a grant containing the exact same string
# under this exact cleaned absolute repository path in the Operator config.
# Total wildcards `*` and `**` are always dropped, even when granted.
safe_roots       = ["./tmp", "./.cache"] # P1: rm -rf permitted here
egress_allowlist = ["api.github.com"]    # P6: hosts curl/wget may reach

# Extra project rules (added to the Base).
[[rules]]
id       = "project.terraform-apply"
tool     = "Bash"
pattern  = "terraform apply*"
decision = "ask"
reason   = "infrastructure change requires operator review"
